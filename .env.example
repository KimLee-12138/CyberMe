# Local development defaults. Copy to .env and replace secrets.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
SECRET_KEY=replace-with-a-random-string

# Docker compose exposes Postgres on loopback 15432 (5432 is often reserved on Windows).
DATABASE_URL=postgresql+asyncpg://cyberme:password@127.0.0.1:15432/cyberme
REDIS_URL=redis://127.0.0.1:6379/0

# AI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional integrations
GITHUB_TOKEN=
# 长江雨课堂只读同步（sessionid 也可以通过 /yuketang 页面写入）
YKT_REGION=changjiang
YKT_SESSIONID=
YKT_REFRESH_MINUTES=15
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Budget / sync
DEFAULT_MODEL_ROUTE=evidence_qa.default
MONTHLY_BUDGET_LIMIT=50.00
SYNC_MAX_FILE_MB=10
RAW_ARCHIVE_UPLOAD=false
